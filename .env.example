# ════════ TelezhkaProxy ════════
# Скопируй в .env и заполни. .env НИКОГДА не коммить (он уже в .gitignore).

BOT_TOKEN=123456:ABC...
ADMIN_IDS=7926367875
BRAND=TelezhkaProxy
SUPPORT=@TelezhkaProxy
# Обязательная подписка на канал (бот должен быть админом канала). Пусто = выкл.
REQUIRED_CHANNEL=@TelezhkaProxy

# Документы (кнопка «📄 Документы» и строка о соглашении при оплате). Пусто = не показывать.
TERMS_URL=https://telegra.ph/...
PRIVACY_URL=https://telegra.ph/...

# ── @CryptoBot → Crypto Pay → Create App. Пусто = оплата криптой выключена ──
CRYPTOPAY_TOKEN=
CRYPTOPAY_TESTNET=false
CRYPTOPAY_ASSETS=USDT,TON

# Сколько устройств на подписку (limitIp в 3X-UI). 0 = без лимита.
DEVICE_LIMIT=3
DB_PATH=data/telezhka.db

# ── Локация: Польша (3X-UI v3.x) ──
# PANEL_URL — адрес панели вместе с секретным путём, БЕЗ /panel на конце:
#   https://1.2.3.4:2053/AbCdEf123
LOC_PL_PANEL_URL=https://1.2.3.4:2053/secretpath
# Панель → Настройки → Безопасность → API Token → сгенерировать (scope: admin)
LOC_PL_API_TOKEN=
# Какие inbound'ы выдаём (колонка ID), через запятую.
#   "1,2,3" — все три (TCP, gRPC, XHTTP) в одной подписке, юзер переключается в приложении
#   "3"     — только XHTTP, один ключ
# С несколькими inbound'ами включи сервер подписок ниже (WEB_PORT + SUB_PUBLIC_URL),
# иначе бот выдаст несколько отдельных ключей.
LOC_PL_INBOUND_ID=1,2,3
# Адрес, который пойдёт в ключ (IP сервера или домен)
LOC_PL_HOST=1.2.3.4
# false, если у панели самоподписанный сертификат
LOC_PL_VERIFY_SSL=true
# Встроенный сервер подписок панели — ссылка подписки любого клиента БЕЗ последней части (subId).
# Юзер получит одну ссылку на все inbound'ы локации. Пусто = бот выдаёт голые ключи.
LOC_PL_SUB_URL=https://s-25434.pl17.h1clayd.shop/ngqgzl7saqmhl9ph

# Новые страны (раскомментируй и заполни, бот сам их подхватит
# и откроет тариф «Все страны»): DE, NL, FI, US
# LOC_DE_PANEL_URL=
# LOC_DE_API_TOKEN=
# LOC_DE_INBOUND_ID=1
# LOC_DE_HOST=
# LOC_DE_VERIFY_SSL=true

# ── Склейка подписок (одна ссылка на все страны) ──
# Сервер берёт подписки со всех панелей (LOC_*_SUB_URL) и отдаёт одной ссылкой.
# Вариант 1: внутри бота — WEB_PORT=8080 и наружу через домен хостинга.
# Вариант 2: отдельно, на любом сервере с доменом — см. sub_server.py (тогда здесь WEB_PORT=0).
# SUB_PUBLIC_URL — внешний адрес склейки; если задан, бот выдаёт ОДНУ ссылку вида
#   https://sub.домен/sub/<токен юзера>
WEB_HOST=0.0.0.0
WEB_PORT=0
# Публичный адрес, по которому этот сервер доступен снаружи (через Caddy/nginx)
SUB_PUBLIC_URL=

# ── Баланс / рефералка ──
# % с каждой оплаты приглашённого друга на баланс пригласившему
REF_PERCENT=10
# Сколько звёзд за 100₽ при пополнении баланса звёздами
STARS_PER_100_RUB=71
# Кнопки быстрого пополнения
TOPUP_PRESETS=100,200,300,500
